# Copy to .env (git-ignored, chmod 600). Everything is optional in dry mode.

# Telegram alerts: FIRE/ARM state events + convex signals and order reports. Empty = disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live execution (only read when started with --live). Use an HL API wallet (agent key, trading-only),
# never the account's own private key. Addresses are public; the key is never logged.
HL_API_WALLET_KEY=
HL_ACCOUNT_ADDRESS=
# Optional: trade a sub-account (its address) instead of the master account.
HL_SUBACCOUNT_ADDRESS=
